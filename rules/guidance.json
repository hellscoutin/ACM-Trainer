{
 "format": "acm-guidance-rules",
 "version": 1,
 "acm": "1.4.8",
 "rules": [
  {
   "id": "dead",
   "depth": 1,
   "priority": 0,
   "when": {
    "field": "alive",
    "op": "==",
    "value": false
   },
   "text": "The casualty has died. Move on to the next casualty.",
   "guide": "The patient model",
   "dead": true
  },
  {
   "id": "m-tourniquet",
   "depth": 1,
   "priority": 10,
   "when": {
    "all": [
     {
      "field": "heavy_{part}",
      "op": "==",
      "value": true
     },
     {
      "not": {
       "field": "tourniquet_{part}",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "Heavy bleeding from the {part}: apply a tourniquet high on the limb.",
   "guide": "External bleeding",
   "each": "limbs"
  },
  {
   "id": "m-core-heavy",
   "depth": 1,
   "priority": 12,
   "when": {
    "field": "heavy_{part}",
    "op": "==",
    "value": true
   },
   "text": "Heavy bleeding from the {part}: dress it now (packing or emergency trauma dressing). A tourniquet cannot go here.",
   "guide": "External bleeding",
   "each": "core"
  },
  {
   "id": "m-bandage",
   "depth": 1,
   "priority": 20,
   "when": {
    "all": [
     {
      "field": "bleeding_{part}",
      "op": "==",
      "value": true
     },
     {
      "not": {
       "field": "heavy_{part}",
       "op": "==",
       "value": true
      }
     },
     {
      "not": {
       "field": "tourniquet_{part}",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "The {part} is still bleeding: bandage it.",
   "guide": "External bleeding",
   "each": "parts"
  },
  {
   "id": "m-dress-under-tq",
   "depth": 1,
   "priority": 58,
   "when": {
    "all": [
     {
      "field": "tourniquet_{part}",
      "op": "==",
      "value": true
     },
     {
      "field": "openWounds_{part}",
      "op": "==",
      "value": true
     }
    ]
   },
   "text": "Tourniquet on the {part}: dress its wounds while the tourniquet holds, then consider taking it off.",
   "guide": "External bleeding",
   "each": "limbs"
  },
  {
   "id": "a-check",
   "depth": 1,
   "priority": 30,
   "when": {
    "all": [
     {
      "field": "unconscious",
      "op": "==",
      "value": true
     },
     {
      "field": "since_checkairway",
      "op": ">",
      "value": 120
     }
    ]
   },
   "text": "Unconscious casualty: check the airway.",
   "guide": "Airway management"
  },
  {
   "id": "a-open",
   "depth": 1,
   "priority": 34,
   "when": {
    "all": [
     {
      "field": "unconscious",
      "op": "==",
      "value": true
     },
     {
      "not": {
       "field": "airwayManaged",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "Keep the airway open: head tilt-chin lift, an NPA or OPA, or the recovery position.",
   "guide": "Airway management"
  },
  {
   "id": "r-check",
   "depth": 1,
   "priority": 40,
   "when": {
    "all": [
     {
      "field": "unconscious",
      "op": "==",
      "value": true
     },
     {
      "field": "since_chestexam",
      "op": ">",
      "value": 180
     }
    ]
   },
   "text": "Check breathing and inspect the chest.",
   "guide": "Assessing breathing"
  },
  {
   "id": "r-check-awake",
   "depth": 1,
   "priority": 40,
   "when": {
    "all": [
     {
      "not": {
       "field": "unconscious",
       "op": "==",
       "value": true
      }
     },
     {
      "field": "torsoWound",
      "op": "==",
      "value": true
     },
     {
      "field": "since_chestexam",
      "op": ">",
      "value": 180
     }
    ]
   },
   "text": "Torso wound: check breathing and listen with the stethoscope (Inspect Chest works only on an unconscious casualty).",
   "guide": "Assessing breathing"
  },
  {
   "id": "r-spo2-low",
   "depth": 1,
   "priority": 42,
   "when": {
    "field": "spo2",
    "op": "<",
    "value": 90
   },
   "text": "SpO2 {spo2} %: find the cause (airway, chest, blood loss) and support breathing with the BVM if it is poor.",
   "guide": "Ventilation and oxygen"
  },
  {
   "id": "c-pulse",
   "depth": 1,
   "priority": 44,
   "when": {
    "all": [
     {
      "field": "unconscious",
      "op": "==",
      "value": true
     },
     {
      "field": "since_checkpulse",
      "op": ">",
      "value": 120
     },
     {
      "not": {
       "field": "aedPads",
       "op": "==",
       "value": true
      }
     },
     {
      "not": {
       "field": "cpr",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "Feel a pulse (carotid, at the head).",
   "guide": "Assessment"
  },
  {
   "id": "c-sys-low",
   "depth": 1,
   "priority": 46,
   "when": {
    "field": "sys",
    "op": "<",
    "value": 90
   },
   "text": "Systolic {sys}: the casualty is in shock. Stop all bleeding and give blood.",
   "guide": "Fluids and blood"
  },
  {
   "id": "c-access",
   "depth": 1,
   "priority": 50,
   "when": {
    "all": [
     {
      "field": "bloodLoss",
      "op": ">=",
      "value": 1
     },
     {
      "not": {
       "field": "hasAccess",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "Blood has been lost: get IV or IO access.",
   "guide": "IV and IO access",
   "minLevel": 1
  },
  {
   "id": "c-dogtag",
   "depth": 1,
   "priority": 52,
   "when": {
    "all": [
     {
      "field": "bloodLoss",
      "op": ">=",
      "value": 2
     },
     {
      "field": "bagsRunning",
      "op": "==",
      "value": 0
     },
     {
      "not": {
       "field": "bloodTypeKnown",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "Check the dog tag for the blood type before hanging blood (O- suits anyone).",
   "guide": "Fluids and blood",
   "minLevel": 1
  },
  {
   "id": "c-fluids",
   "depth": 1,
   "priority": 54,
   "when": {
    "all": [
     {
      "field": "bloodLoss",
      "op": ">=",
      "value": 2
     },
     {
      "field": "hasAccess",
      "op": "==",
      "value": true
     },
     {
      "field": "bagsRunning",
      "op": "==",
      "value": 0
     }
    ]
   },
   "text": "A lot of blood lost: hang blood (compatible type, or O-).",
   "guide": "Fluids and blood",
   "minLevel": 1
  },
  {
   "id": "c-casevac",
   "depth": 1,
   "priority": 56,
   "when": {
    "all": [
     {
      "field": "bloodLoss",
      "op": ">=",
      "value": 2
     }
    ]
   },
   "text": "A lot of blood lost: call for a medic and keep the bleeding stopped.",
   "guide": "External bleeding",
   "maxLevel": 0
  },
  {
   "id": "d-fracture",
   "depth": 1,
   "priority": 60,
   "when": {
    "all": [
     {
      "field": "fractured_{part}",
      "op": "==",
      "value": true
     },
     {
      "not": {
       "field": "splinted_{part}",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "The {part} is fractured: splint it (a medic realigns it first).",
   "guide": "Fractures",
   "each": "limbs",
   "maxLevel": 0
  },
  {
   "id": "d-fracture-medic",
   "depth": 1,
   "priority": 60,
   "when": {
    "all": [
     {
      "field": "fractured_{part}",
      "op": "==",
      "value": true
     },
     {
      "not": {
       "field": "splinted_{part}",
       "op": "==",
       "value": true
      }
     },
     {
      "not": {
       "field": "realigned_{part}",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "The {part} is fractured: realign it (lidocaine first eases the pain), then splint it.",
   "guide": "Fractures",
   "each": "limbs",
   "minLevel": 1
  },
  {
   "id": "d-splint",
   "depth": 1,
   "priority": 61,
   "when": {
    "all": [
     {
      "field": "fractured_{part}",
      "op": "==",
      "value": true
     },
     {
      "field": "realigned_{part}",
      "op": "==",
      "value": true
     }
    ]
   },
   "text": "The {part} is realigned: apply the SAM splint now.",
   "guide": "Fractures",
   "each": "limbs",
   "minLevel": 1
  },
  {
   "id": "monitor",
   "depth": 1,
   "priority": 70,
   "when": {
    "all": [
     {
      "not": {
       "field": "pulseOx",
       "op": "==",
       "value": true
      }
     },
     {
      "any": [
       {
        "field": "unconscious",
        "op": "==",
        "value": true
       },
       {
        "field": "bloodLoss",
        "op": ">=",
        "value": 1
       }
      ]
     }
    ]
   },
   "text": "Place a pulse oximeter to watch SpO2 and heart rate.",
   "guide": "Assessment"
  },
  {
   "id": "e-pain",
   "depth": 1,
   "priority": 80,
   "when": {
    "field": "inPain",
    "op": "==",
    "value": true
   },
   "text": "Treat the pain: paracetamol, or morphine for severe pain.",
   "guide": "Pain and consciousness",
   "maxLevel": 0
  },
  {
   "id": "e-pain-medic",
   "depth": 1,
   "priority": 80,
   "when": {
    "field": "inPain",
    "op": "==",
    "value": true
   },
   "text": "Treat the pain: paracetamol for mild pain, a small IV morphine or fentanyl dose for severe pain (watch the total).",
   "guide": "Pain and consciousness",
   "minLevel": 1
  },
  {
   "id": "cbrn-cloud",
   "depth": 1,
   "priority": 5,
   "when": {
    "all": [
     {
      "field": "inCloud",
      "op": "==",
      "value": true
     },
     {
      "not": {
       "field": "gasMask",
       "op": "==",
       "value": true
      }
     },
     {
      "field": "unconscious",
      "op": "==",
      "value": true
     }
    ]
   },
   "text": "Still in the chemical cloud: put a gas mask on the casualty and drag them out of the contaminated area first.",
   "guide": "Protection and antidotes"
  },
  {
   "id": "cbrn-cloud-awake",
   "depth": 1,
   "priority": 5,
   "when": {
    "all": [
     {
      "field": "inCloud",
      "op": "==",
      "value": true
     },
     {
      "not": {
       "field": "gasMask",
       "op": "==",
       "value": true
      }
     },
     {
      "not": {
       "field": "unconscious",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "Still in the chemical cloud: drag the casualty out of the contaminated area first (you can only put a mask on an unconscious casualty).",
   "guide": "Protection and antidotes"
  },
  {
   "id": "cbrn-cloud-masked",
   "depth": 1,
   "priority": 6,
   "when": {
    "all": [
     {
      "field": "inCloud",
      "op": "==",
      "value": true
     },
     {
      "field": "gasMask",
      "op": "==",
      "value": true
     }
    ]
   },
   "text": "Still in the contaminated area: drag the casualty out (the mask filter runs down while they stay).",
   "guide": "Protection and antidotes"
  },
  {
   "id": "cbrn-filter",
   "depth": 1,
   "priority": 6,
   "when": {
    "all": [
     {
      "field": "inCloud",
      "op": "==",
      "value": true
     },
     {
      "field": "gasMask",
      "op": "==",
      "value": true
     },
     {
      "field": "filterSpent",
      "op": "==",
      "value": true
     }
    ]
   },
   "text": "The gas mask filter is spent: replace it.",
   "guide": "Protection and antidotes"
  },
  {
   "id": "cbrn-atna",
   "depth": 1,
   "priority": 14,
   "when": {
    "all": [
     {
      "field": "cbrnAgent",
      "op": "==",
      "value": "Sarin"
     },
     {
      "field": "atropineGiven",
      "op": "<",
      "value": 2
     }
    ]
   },
   "text": "Nerve agent: give 2-3 ATNA autoinjectors now (3 or more active doses keep breathing going; 4 or more clear the airway spasm).",
   "guide": "Protection and antidotes"
  },
  {
   "id": "cbrn-midazolam",
   "depth": 1,
   "priority": 65,
   "when": {
    "all": [
     {
      "field": "cbrnAgent",
      "op": "==",
      "value": "Sarin"
     },
     {
      "not": {
       "field": "midazolamGiven",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "Nerve agent: the midazolam autoinjector stops the tremors and seizures.",
   "guide": "Protection and antidotes"
  },
  {
   "id": "cbrn-dimercaprol",
   "depth": 1,
   "priority": 26,
   "when": {
    "all": [
     {
      "field": "cbrnAgent",
      "op": "==",
      "value": "Lewisite"
     },
     {
      "not": {
       "field": "dimercaprolGiven",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "Blister agent: draw the dimercaprol ampule into a syringe and inject it IM (an IV push does nothing); it removes lewisite from the body.",
   "guide": "Protection and antidotes",
   "minLevel": 1
  },
  {
   "id": "cbrn-wash-eyes",
   "depth": 1,
   "priority": 75,
   "when": {
    "field": "canWashEyes",
    "op": "==",
    "value": true
   },
   "text": "Wash the casualty's eyes with water (chlorine or lewisite above 50 makes the blindness permanent).",
   "guide": "Protection and antidotes"
  },
  {
   "id": "i-no-carotid",
   "depth": 2,
   "priority": 3,
   "when": {
    "all": [
     {
      "field": "f_carotid",
      "op": "==",
      "value": 0
     },
     {
      "field": "since_checkpulse",
      "op": "<",
      "value": 120
     },
     {
      "not": {
       "field": "cpr",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "No carotid pulse: start CPR now and connect the AED.",
   "guide": "Cardiac arrest",
   "supersedes": [
    "c-pulse"
   ]
  },
  {
   "id": "i-shockable",
   "depth": 2,
   "priority": 4,
   "when": {
    "all": [
     {
      "field": "f_shockable",
      "op": "==",
      "value": true
     },
     {
      "field": "aedPads",
      "op": "==",
      "value": true
     }
    ]
   },
   "text": "Shockable rhythm: charge and shock, then resume CPR at once for 2 minutes.",
   "guide": "Cardiac arrest"
  },
  {
   "id": "i-not-breathing",
   "depth": 2,
   "priority": 6,
   "when": {
    "all": [
     {
      "field": "f_noBreathing",
      "op": "==",
      "value": true
     },
     {
      "not": {
       "field": "bvm",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "Not breathing: open the airway and ventilate with the BVM; feel for a pulse.",
   "guide": "Ventilation and oxygen"
  },
  {
   "id": "i-deviation",
   "depth": 2,
   "priority": 15,
   "when": {
    "all": [
     {
      "field": "f_deviation",
      "op": "==",
      "value": true
     },
     {
      "field": "chestSeal",
      "op": "==",
      "value": true
     }
    ]
   },
   "text": "Tracheal deviation: tension pneumothorax. Needle decompression (NCD) now.",
   "guide": "Chest treatment",
   "minLevel": 1
  },
  {
   "id": "i-deviation-noseal",
   "depth": 2,
   "priority": 15,
   "when": {
    "all": [
     {
      "field": "f_deviation",
      "op": "==",
      "value": true
     },
     {
      "not": {
       "field": "chestSeal",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "Tracheal deviation: tension pneumothorax. Chest seal first, then needle decompression (NCD); without the seal the pneumothorax builds up again.",
   "guide": "Chest treatment",
   "minLevel": 1
  },
  {
   "id": "i-deviation-cls",
   "depth": 2,
   "priority": 15,
   "when": {
    "field": "f_deviation",
    "op": "==",
    "value": true
   },
   "text": "Tracheal deviation: tension pneumothorax. Get a medic for needle decompression now.",
   "guide": "Chest treatment",
   "maxLevel": 0
  },
  {
   "id": "i-obstructed",
   "depth": 2,
   "priority": 24,
   "when": {
    "all": [
     {
      "field": "f_obstructed",
      "op": "==",
      "value": true
     },
     {
      "not": {
       "field": "recoveryPosition",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "Airway obstructed (vomit or blood): suction it or turn the head, then the recovery position.",
   "guide": "Airway management"
  },
  {
   "id": "i-collapse",
   "depth": 2,
   "priority": 26,
   "when": {
    "all": [
     {
      "field": "f_collapse",
      "op": "==",
      "value": true
     },
     {
      "not": {
       "field": "airwayManaged",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "Airway collapsing: head tilt-chin lift now, then an NPA, OPA or i-gel.",
   "guide": "Airway management",
   "supersedes": [
    "a-open"
   ]
  },
  {
   "id": "i-uneven-seal",
   "depth": 2,
   "priority": 35,
   "when": {
    "all": [
     {
      "field": "f_uneven",
      "op": "==",
      "value": true
     },
     {
      "not": {
       "field": "chestSeal",
       "op": "==",
       "value": true
      }
     },
     {
      "field": "torsoWound",
      "op": "==",
      "value": true
     }
    ]
   },
   "text": "Uneven chest rise: apply a chest seal, then inspect the chest again.",
   "guide": "Chest treatment"
  },
  {
   "id": "i-uneven-sealed",
   "depth": 2,
   "priority": 45,
   "when": {
    "all": [
     {
      "field": "f_uneven",
      "op": "==",
      "value": true
     },
     {
      "field": "chestSeal",
      "op": "==",
      "value": true
     }
    ]
   },
   "text": "Chest still uneven after the seal: watch for tension (tracheal deviation, worse breathing) and decompress only then; NCD on a chest without tension makes it worse.",
   "guide": "Chest treatment"
  },
  {
   "id": "i-bruising",
   "depth": 2,
   "priority": 38,
   "when": {
    "field": "f_bruising",
    "op": "==",
    "value": true
   },
   "text": "Extensive chest bruising: more than 0.5 L of blood in the chest (hemothorax). TXA 1 g IV, then a thoracostomy (lidocaine first) and chest tube to drain it.",
   "guide": "Chest injuries",
   "minLevel": 1
  },
  {
   "id": "i-shallow-chest",
   "depth": 2,
   "priority": 36,
   "when": {
    "all": [
     {
      "field": "f_shallow",
      "op": "==",
      "value": true
     },
     {
      "field": "torsoWound",
      "op": "==",
      "value": true
     },
     {
      "not": {
       "field": "chestSeal",
       "op": "==",
       "value": true
      }
     }
    ]
   },
   "text": "Shallow breathing with a torso wound: suspect a pneumothorax. Apply a chest seal, then check breathing again.",
   "guide": "Chest treatment"
  },
  {
   "id": "i-shallow",
   "depth": 2,
   "priority": 41,
   "when": {
    "all": [
     {
      "field": "f_shallow",
      "op": "==",
      "value": true
     },
     {
      "not": {
       "field": "f_uneven",
       "op": "==",
       "value": true
      }
     },
     {
      "any": [
       {
        "not": {
         "field": "torsoWound",
         "op": "==",
         "value": true
        }
       },
       {
        "field": "chestSeal",
        "op": "==",
        "value": true
       }
      ]
     }
    ]
   },
   "text": "Shallow breathing: check the airway and look for the cause in the chest.",
   "guide": "Assessing breathing"
  },
  {
   "id": "i-crt",
   "depth": 2,
   "priority": 47,
   "when": {
    "all": [
     {
      "field": "f_crtSlow",
      "op": "==",
      "value": true
     },
     {
      "field": "bloodBags",
      "op": "==",
      "value": 0
     }
    ]
   },
   "text": "Capillary refill {f_crt} s: poor circulation. Stop bleeding and give blood.",
   "guide": "Fluids and blood",
   "minLevel": 1
  },
  {
   "id": "i-limb-pulse",
   "depth": 2,
   "priority": 48,
   "when": {
    "all": [
     {
